# Supra EVM QA is NOT a public/well-known chain — the contract reference doc
# doesn't state its chain id or RPC URL, so both are required. Until they're
# set the app shows a "Network not configured" screen.
VITE_SUPRA_EVM_QA_CHAIN_ID=
VITE_SUPRA_EVM_QA_RPC_URL=
# Optional — powers the "View on explorer" link in the account menu.
VITE_SUPRA_EVM_QA_EXPLORER_URL=

# Optional site-wide password gate. Set VITE_SITE_PASSWORD_ENABLED=true and
# VITE_SITE_PASSWORD to lock the whole app behind a password prompt; leave
# VITE_SITE_PASSWORD_ENABLED unset/false to disable it. This is a soft,
# client-side gate only — the password ends up in the built JS bundle, so
# don't rely on it to protect anything actually sensitive.
VITE_SITE_PASSWORD_ENABLED=false
VITE_SITE_PASSWORD=
